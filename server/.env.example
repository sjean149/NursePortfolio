# Copy to .env for local development. Never commit the real .env.

# Option A: a single connection string (this is what Render provides)
# DATABASE_URL=postgres://user:password@host:5432/nurse_portfolio

# Option B: individual settings for a local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nurse_portfolio
DB_USER=postgres
DB_PASSWORD=

# Set to "true" to force SSL locally (SSL is on automatically when NODE_ENV=production)
# DB_SSL=true

# Comma-separated list of allowed frontend origins (leave unset to allow all)
# CLIENT_URL=http://localhost:5173

EMAIL_USER=
EMAIL_PASS=
